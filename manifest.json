{
  "manifest_version": 3,
  "name": "abc",
  "version": "1.0.0",
  "description": "ttt",
  "permissions": ["storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Forms AI Answer",
    "default_popup": "popup.html"
  }
}
